{
  // See https://go.microsoft.com/fwlink/?LinkId=733558
  // for the documentation about the tasks.json format
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Packer Init",
      "type": "shell",
      "command": "packer init .",
      "options": {
        "cwd": "${workspaceFolder}/google-cloud/image"
      },
      "problemMatcher": [],
      "group": "build"
    },
    {
      "label": "Packer Build",
      "type": "shell",
      "command": "packer build -var-file=env.pkrvars.hcl .",
      "options": {
        "cwd": "${workspaceFolder}/google-cloud/image"
      },
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    }
  ]
}
